    {
      "name": "01 - Authentication & Session Management",
      "item": [
        {
          "name": "01. Retrieve CSRF Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "csrf",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('CSRF token returned in payload', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('csrfToken');",
                  "    pm.environment.set('csrfToken', data.csrfToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02. SuperAdmin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"{{adminUser}}\", \"password\": \"{{adminPass}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Authenticated as Super Admin', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.authenticated).to.be.true;",
                  "    pm.expect(data.user.username).to.eql('SuperAdmin');",
                  "});"
                ]
              }
            }
          ]
        },
        {
