              }
            }
          ]
        },
        {
          "name": "05. Security Regression: demo_role Auth Bypass Rejection (BUG-001)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"demo_role\": \"Super Admin\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Rejects passwordless demo login', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.error).to.include('Password authentication is required');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
